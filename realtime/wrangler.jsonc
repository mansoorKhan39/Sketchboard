{
  "name": "sketchboard-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  // The free plan only allows SQLite-backed Durable Objects, hence new_sqlite_classes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Address of the website/API (where /api/v1/internal/... lives). Change it after deploying to Vercel.
    "API_BASE": "http://localhost:5173"
  }
  // Secret (not stored here):  REALTIME_SECRET
  //   local: put it in .dev.vars      production: npx wrangler secret put REALTIME_SECRET
}
