# Copy these into Vercel -> Project -> Settings -> Environment Variables (see DEPLOY.md).
# Not needed for local development: `npm run dev` stores data in .data/db.json instead.

# From MongoDB Atlas -> Connect -> Drivers. Looks like mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# Any long random text. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional (default is "sketchboard")
MONGODB_DB=sketchboard

# Live collaboration (optional; see DEPLOY.md step 3). From ably.com -> your app -> API Keys. Looks like appId.keyId:secret
ABLY_API_KEY=

# "Continue with Google" (optional; see DEPLOY.md step 4). The Client ID is public.
GOOGLE_CLIENT_ID=

# Password reset e-mails (optional; see DEPLOY.md step 5). Without these, "Forgot password?" is hidden on the
# server; in development the e-mail is printed in the terminal instead.
BREVO_API_KEY=
MAIL_FROM=
APP_URL=
